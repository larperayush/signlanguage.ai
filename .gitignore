# ==============================================================================
# SignFlow Studio — Git Ignore Configuration
# Open-Source AI Model Harness
# ==============================================================================

# Python Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/
*.venv

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Datasets and Training CSV Data
*.csv
data/
datasets/

# AI Model Binaries (Harness loads custom models dynamically via 'Add Model')
models/*.joblib
models/*.task
models/*.onnx
models/*.pkl
models/*.h5
models/*.keras
models/*.pt
models/*.pth
!models/.gitkeep

# PyInstaller / Build Artifacts
build/
dist/
*.spec.bak
test_renders/

# IDE, Editor, and OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp

# Logs
*.log
